# Browser API path. Keep relative locally so Vite can proxy it without CORS.
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:5000
VITE_API_TIMEOUT_MS=15000
VITE_PUBLIC_APP_URL=http://localhost:5173

# Opt-in only. Production should keep this false so API failures are visible.
VITE_USE_DEMO_DATA=false

# Supabase Auth (Project Settings > API). The publishable key is safe to expose.
# Leave both blank to use the API's own email/password login (AUTH_MODE=legacy|hybrid).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
