NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/roost
# Auth: "supabase" (Supabase Auth only), "hybrid" (Supabase + legacy
# email/password tokens from this API; use while migrating), or "legacy".
AUTH_MODE=supabase
SUPABASE_URL=https://fpccdjzhsprfsmgrizly.supabase.co
# Optional. Server-only secret (Supabase > Settings > API keys > service_role / secret key).
# Enables admin-created staff/owner logins and admin password resets. NEVER put it in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still using the legacy HS256 JWT secret (no signing keys).
SUPABASE_JWT_SECRET=

# Legacy tokens only (required when AUTH_MODE is hybrid or legacy).
# JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# Comma-separated browser origins. Do not add a trailing slash.
CORS_ORIGINS=http://localhost:5173
REQUEST_BODY_LIMIT=1mb
# Public URL of the frontend (used in owner invite / reset email links).
PUBLIC_APP_URL=http://localhost:5173
BASE_URL=http://localhost:5000
PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Optional integrations
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v19.0
# Set true for Supabase/hosted Postgres (encrypted, CA not verified). Leave
# blank for local Postgres. Do NOT put ?sslmode=... in DATABASE_URL; it
# overrides this setting in the pg driver.
DB_SSL=false
DB_POOL_MAX=10
